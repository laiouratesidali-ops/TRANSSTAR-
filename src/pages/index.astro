    <script>
      /* menu mobile */
      const burger = document.getElementById('burger');
      const nav = document.getElementById('main-nav');
      burger?.addEventListener('click', () => {
        const open = nav?.classList.toggle('open');
        burger.setAttribute('aria-expanded', open ? 'true' : 'false');
      });
      nav?.querySelectorAll('a').forEach((link) =>
        link.addEventListener('click', () => nav.classList.remove('open'))
      );

      /* estimation + WhatsApp */
      const factors = {
        'Convoi exceptionnel': 1.9,
        'Matériel industriel': 1.35,
        'Vrac & matériaux': 1.0,
        'Site industriel / pétrolier': 1.55,
        'Transport national': 1.0,
        'Études & logistique': 0.5,
      };
      const el = (id) => document.getElementById(id);
      const form = el('devis-form');
      const fmt = (n) => new Intl.NumberFormat('fr-FR').format(Math.round(n)) + ' DA';

      function recalc() {
        const service = el('service')?.value || 'Transport national';
        const km = Number(el('distance')?.value || 0);
        const tons = Number(el('tonnes')?.value || 0);
        const factor = factors[service] ?? 1;
        const base = (15000 + km * 180 + tons * 1800) * factor;
        const low = base * 0.92;
        const high = base * 1.12;

        const out = el('estimate-value');
        if (out) out.textContent = fmt(low) + ' — ' + fmt(high);

        const message = [
          'Demande de devis — TRANSSTAR LAIOURATE',
          'Nom : ' + (el('name')?.value?.trim() || '—'),
          'Société : ' + (el('societe')?.value?.trim() || '—'),
          'Téléphone : ' + (el('phone')?.value?.trim() || '—'),
          'E-mail : ' + (el('email')?.value?.trim() || '—'),
          'Prestation : ' + service,
          'Marchandise : ' + (el('marchandise')?.value?.trim() || '—'),
          'Trajet : ' + (el('depart')?.value?.trim() || '—') + ' → ' + (el('destination')?.value?.trim() || '—'),
          'Distance : ' + km + ' km',
          'Poids : ' + tons + ' t · Unités : ' + (el('unites')?.value || '1'),
          'Chargement : ' + (el('date')?.value || '—'),
          'Précisions : ' + (el('precisions')?.value?.trim() || '—'),
          'Estimation : ' + fmt(low) + ' — ' + fmt(high),
        ].join('\n');

        const wa = el('wa-send');
        if (wa) wa.href = 'https://wa.me/213697056401?text=' + encodeURIComponent(message);
      }

      form?.addEventListener('input', recalc);
      form?.addEventListener('change', recalc);

      const dateInput = el('date');
      if (dateInput) {
        const tomorrow = new Date();
        tomorrow.setDate(tomorrow.getDate() + 1);
        dateInput.value = tomorrow.toISOString().slice(0, 10);
      }
      recalc();

      /* suivi de convoi */
      const labels = ['Demande reçue', 'Chargement effectué', 'Convoi en route', 'Livraison effectuée'];
      const shipments = {
        'TS-1042': {
          from: 'Ghardaïa', to: 'Hassi Messaoud', weight: '28 t', pieces: '1 convoi',
          service: 'Convoi exceptionnel', status: 4, eta: 'livré le 21/10/2026',
          events: [
            ['Demande reçue', '18/10/2026 · 09:20'],
            ['Chargement effectué', '18/10/2026 · 15:40'],
            ['Convoi en route', '19/10/2026 · 06:00'],
            ['Livraison effectuée', '21/10/2026 · 11:15'],
          ],
        },
        'TS-2150': {
          from: 'Ghardaïa', to: 'Alger', weight: '18 t', pieces: '4 colis',
          service: 'Matériel industriel', status: 3, eta: '22/10/2026',
          events: [
            ['Demande reçue', '20/10/2026 · 10:10'],
            ['Chargement effectué', '21/10/2026 · 08:30'],
            ['Convoi en route', '21/10/2026 · 14:00'],
            ['Livraison effectuée', 'prévue le 22/10/2026'],
          ],
        },
        'TS-3300': {
          from: 'Ouargla', to: 'Ghardaïa', weight: '32 t', pieces: '1 benne',
          service: 'Vrac & matériaux', status: 2, eta: '23/10/2026',
          events: [
            ['Demande reçue', '21/10/2026 · 16:00'],
            ['Chargement effectué', '22/10/2026 · 07:15'],
            ['Convoi en route', 'prévu le 22/10/2026'],
            ['Livraison effectuée', 'prévue le 23/10/2026'],
          ],
        },
      };

      const trackForm = document.getElementById('track-form');
      const trackInput = document.getElementById('track-input');
      const trackResult = document.getElementById('track-result');

      const esc = (v) =>
        String(v).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

      function renderTrack(key) {
        const s = shipments[key];
        if (!s) {
          trackResult.innerHTML =
            '<div class="notice">Aucun convoi trouvé avec le numéro « ' + esc(key) + ' ». Vérifiez le numéro ou contactez-nous.</div>';
          return;
        }
        const progress = Math.min(100, Math.round((s.status / 4) * 100));
        const state = s.status >= 4 ? 'Livré' : labels[s.status];
        const events = s.events
          .map((ev, i) => {
            const cls = i < s.status ? 'done' : i === s.status ? 'current' : '';
            const dot = i < s.status ? '✓' : String(i + 1);
            return '<div class="t-item ' + cls + '"><div class="t-dot">' + dot + '</div>' +
              '<div class="t-body"><b>' + esc(ev[0]) + '</b><span>' + esc(ev[1]) + '</span></div></div>';
          })
          .join('');

        trackResult.innerHTML =
          '<div class="track-head"><div><div class="num">' + esc(key) + '</div>' +
          '<div class="route">' + esc(s.from) + ' → ' + esc(s.to) + ' · ' + esc(s.service) + '</div></div>' +
          '<div style="text-align:right"><span class="chip">' + esc(state) + '</span>' +
          '<div class="route">Livraison : ' + esc(s.eta) + '</div></div></div>' +
          '<div class="bar"><div class="bar-fill" style="width:' + progress + '%"></div></div>' +
          '<div class="timeline">' + events + '</div>' +
          '<div class="stats" style="margin-top:20px">' +
          '<div class="stat"><b style="font-size:17px">' + esc(s.weight) + '</b><span>Poids</span></div>' +
          '<div class="stat"><b style="font-size:17px">' + esc(s.pieces) + '</b><span>Unités</span></div>' +
          '<div class="stat"><b style="font-size:17px">' + esc(s.service) + '</b><span>Prestation</span></div>' +
          '</div>';
      }

      trackForm?.addEventListener('submit', (e) => {
        e.preventDefault();
        const key = (trackInput?.value || '').trim().toUpperCase();
        if (key) renderTrack(key);
      });
    </script>
  </body>
</html>
