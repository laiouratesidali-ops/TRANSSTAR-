    <script>
        // إعداد التاريخ الحالي
        const today = new Date().toLocaleDateString('fr-FR');
        document.getElementById('current-date').innerText = today;
        document.getElementById('invoice-date').innerText = today;

        // دالة تحديث الفاتورة
        function updateInvoice() {
            // جلب البيانات من المدخلات
            const client = document.getElementById('input-client').value;
            const desc = document.getElementById('input-desc').value;
            const qty = parseFloat(document.getElementById('input-qty').value) || 0;
            const price = parseFloat(document.getElementById('input-price').value) || 0;
[24/10/2026 01:22] Sidali La: // الحسابات
            const totalHT = qty * price;
            const tva = totalHT * 0.19;
            const totalTTC = totalHT + tva;

            // تنسيق الأرقام كعملة دينار جزائري
            const formatMoney = (amount) => new Intl.NumberFormat('fr-DZ', { minimumFractionDigits: 2 }).format(amount) + ' DZD';

            // عرض البيانات في الفاتورة
            document.getElementById('display-client').innerText = client || 'Client Anonyme';
            document.getElementById('display-desc').innerText = desc || 'Service de base';
            document.getElementById('display-qty').innerText = qty;
            document.getElementById('display-price').innerText = formatMoney(price);
            document.getElementById('display-total').innerText = formatMoney(totalHT);

            document.getElementById('summary-ht').innerText = formatMoney(totalHT);
            document.getElementById('summary-tva').innerText = formatMoney(tva);
            document.getElementById('summary-ttc').innerText = formatMoney(totalTTC);
        }

        // ربط زر التحديث
        document.getElementById('update-btn').addEventListener('click', updateInvoice);

        // ربط زر الطباعة/تحميل PDF
        document.getElementById('print-btn').addEventListener('click', () => {
            updateInvoice(); // تحديث أخير قبل الطباعة
            window.print();
        });
    </script>
